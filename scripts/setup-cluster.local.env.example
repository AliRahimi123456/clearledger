# Optional: copy to setup-cluster.local.env (gitignored) for a beefier lab VM.
# Example for a 32–64GB host running Stages 7–7.5 with headroom:
#
#   cp scripts/setup-cluster.local.env.example scripts/setup-cluster.local.env
#
CLEARLEDGER_VM_CPUS=8
CLEARLEDGER_VM_MEMORY=16G
# Default via setup-cluster.sh is 80G (full Stages 0–7.5). Raise if your host has room.
CLEARLEDGER_VM_DISK=80G
