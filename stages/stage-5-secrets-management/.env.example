# Copy to .env in this directory — NEVER commit .env
#
# VAULT_TOKEN: dev root token you choose at Helm install (lab only).
# SEED_*: one-time values you load INTO Vault (not stored in Git or scripts).
# Fill these from your current cluster/passwords once, then delete K8s app Secrets.

VAULT_TOKEN=

# Auth service (clearledger/data/auth-service)
SEED_AUTH_DATABASE_URL=
SEED_AUTH_JWT_SECRET=

# Ledger service (clearledger/data/ledger-service)
SEED_LEDGER_DATABASE_URL=
